# Copyrighted game data -- never commit these.
disc/*
!disc/README.md

# Recompiler output: derived from the disc, so it is also copyrighted.
generated/

# .NET build artifacts
bin/
obj/

# tools/RecompOne is a subtree of the fork (see scripts/setup_tools.sh); its own
# .gitignore covers bin/ and obj/ there. The 15.7 MB PSY-Q signature bank is read
# only by the standalone --autoconfigure command; setup_tools.sh --signatures
# fetches it on demand.
tools/RecompOne/RecompOne.Recompiler/AutoConfigure/signatures/psyq.json

# Written by the runtime at play time: memory card saves and host settings.
*.sav
*.sav.bak
# 0106: a damaged card, settings.json or interface.ini kept aside, and a write in flight.
*.damaged-*
*.pre-restore-*
# System > Memory Cards > Backup, when the game is run from this tree.
/backups/
/*.tmp
settings.json
# Verdite Core's WindowIcon keeps the disc's card icon here for the next run.
/icon.png
/icon.ico
# The runtime's crash reports (0107), with the game RAM beside each.
/crashes/
interface.ini

# Written by patches/MapFog.cs beside the memory card: explored-tile records.
*.fog
*.fog.tmp

# Optional runtime asset-replacement packs
packs/
# The remaster editor's pack exports
exports/

# Upstream's texture dumper writes the disc's textures here, and the census its reports.
dump/

__pycache__/
*.pyc

# ModLoader compiles mods/ at run time and caches the assemblies here.
mods/.cache/

# RateCensus writes its dump here by default (KF2_RATECENSUS_OUT); it is a
# diagnostic reading of one session, not source. One was committed once.
ratecensus.txt

# Working files: extracted disc executables and probe logs.
scratch/

# Captured stdout from a run, kept while a defect is being read. A reading of
# one session, not source -- same reason as ratecensus.txt above.
*.log

# Release artefacts.
dist/
dump/
