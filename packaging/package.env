# What the shared packaging (tools/verdite-core/packaging) calls this port.
# Read by the AppImage script, the Windows script and its installer, and
# scripts/release.sh; one KEY=VALUE a line, for bash and PowerShell alike.
NAME=Deception
APP_ID=deception
# The apphost under bin\ and usr/bin. The game assembly is also Deception, so the
# launcher assembly cannot be: LoadFromAssemblyPath would find the one already
# in the process. The stub the player double-clicks is still NAME.exe.
LAUNCHER_ASSEMBLY=DeceptionLauncher
# The Inno Setup AppId: how Windows tells an upgrade of Deception from another
# program. Never change it, and never give another port this one.
INNO_APP_ID=C4E8A1D7-6B25-4F93-8E0A-2D7C5B91F6A4
# A per-user install: its shortcuts are the player's, so the game can point them
# at the card icon it reads off the disc. See "The shortcuts wear it too" in docs/PACKAGING.md.
INNO_PRIVILEGES=lowest
